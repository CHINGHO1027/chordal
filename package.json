{
  "name": "chordal",
  "version": "0.1.0",
  "description": "A tunable, zero-audio-file sonic design system for the web, powered by the Web Audio API.",
  "type": "module",
  "license": "MIT",
  "author": "CHING",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CHINGHO1027/chordal.git"
  },
  "homepage": "https://github.com/CHINGHO1027/chordal#readme",
  "bugs": {
    "url": "https://github.com/CHINGHO1027/chordal/issues"
  },
  "keywords": [
    "web-audio",
    "sound-design",
    "ui-sounds",
    "interaction-sound",
    "synthesis"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./lite": {
      "types": "./dist/lite.d.ts",
      "default": "./dist/lite.js"
    },
    "./soft-bubble": {
      "types": "./dist/families/soft-bubble.d.ts",
      "default": "./dist/families/soft-bubble.js"
    },
    "./glass-crystal": {
      "types": "./dist/families/glass-crystal.d.ts",
      "default": "./dist/families/glass-crystal.js"
    },
    "./paper-snap": {
      "types": "./dist/families/paper-snap.d.ts",
      "default": "./dist/families/paper-snap.js"
    },
    "./metallic-tact": {
      "types": "./dist/families/metallic-tact.d.ts",
      "default": "./dist/families/metallic-tact.js"
    },
    "./chime": {
      "types": "./dist/families/chime.d.ts",
      "default": "./dist/families/chime.js"
    },
    "./digital-blip": {
      "types": "./dist/families/digital-blip.d.ts",
      "default": "./dist/families/digital-blip.js"
    },
    "./spring": {
      "types": "./dist/families/spring.d.ts",
      "default": "./dist/families/spring.js"
    },
    "./tiny-sparkle": {
      "types": "./dist/families/tiny-sparkle.d.ts",
      "default": "./dist/families/tiny-sparkle.js"
    },
    "./snap": {
      "types": "./dist/families/snap.d.ts",
      "default": "./dist/families/snap.js"
    }
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/lite.js",
    "dist/lite.d.ts",
    "dist/families",
    "dist/chunk-*.js",
    "dist/types-*.d.ts"
  ],
  "scripts": {
    "build": "tsup",
    "build:site": "npm run build && rm -rf site/dist site/AGENTS.md && cp -r dist site/dist && cp AGENTS.md site/AGENTS.md",
    "size": "npm run build && gzip -c dist/index.js | wc -c",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
